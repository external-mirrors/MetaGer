APP_ENV=local
APP_DEBUG=true
APP_LOG_LEVEL=debug
LOG_CHANNEL=stderr
APP_KEY=
APP_TIMEZONE=Europe/Berlin
APP_URL=http://nginx:8080

# The interface language is read from ?lang=/MG-Locale, the URL prefix, the
# mg_locale cookie and Accept-Language, in that order; the domain is only the
# last-resort fallback and never causes a redirect. Set to false to restore the
# previous rules, where metager.de forced German and a language switch could
# move the user to the other domain.
LOCALE_DECOUPLED=true

BOT_PROTECTION=true
# Whitelist for Bot protextion. Comma seperated list of IP-Addresses or CIDR Ranges
BOT_PROTECTION_WHITELIST=

DB_CONNECTION=sqlite
DB_DATABASE=metager
DB_USERNAME=metager
DB_PASSWORD="metager"

# Split reads off the primary. DB_HOST keeps the writes; DB_READ_HOST takes the
# selects. On CloudNativePG that means DB_HOST=<cluster>-rw and
# DB_READ_HOST=<cluster>-r — `-r` rather than `-ro`, because `-r` is already
# replicas-only during the switchover (CNPG drops an instance from it the moment
# it stops being Ready) and still has endpoints when the cluster is briefly down
# to a single instance, which `-ro` does not. Use `-ro` only to keep reads off
# the primary as a load decision.
#
# The point is the five to fifteen seconds a switchover costs writes: reads do
# not have to stop for it. Unset — the default, and what compose and the review
# environments use — this is one host and one connection, exactly as before.
#
# DB_STICKY (default true) keeps a request reading from the primary once it has
# written, so nothing renders from a replica that has not caught up. See
# config/database.php.
#DB_READ_HOST=
#DB_READ_PORT=
#DB_STICKY=true

REDIS_RESULT_CONNECTION=default
REDIS_RESULT_CACHE_DURATION=60

BROADCAST_DRIVER=log
CACHE_STORE=redis
CACHE_PREFIX=metager:
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
# Where a queued broadcast is pushed, and onto which queue. Kept separate from
# QUEUE_CONNECTION because in production that one is `database` (Postgres) and a
# broadcast must not put a SQL write on the start or result page — see
# config/broadcasting.php. Whatever connection is named here needs a worker
# serving BROADCAST_QUEUE; the compose `queue` service already lists it.
BROADCAST_QUEUE_CONNECTION=redis
BROADCAST_QUEUE=broadcasts

SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_COOKIE=metager_session
SESSION_ENCRYPT=true

REDIS_CACHE_CONNECTION=default
REDIS_CACHE_LOCK_CONNECTION=default
REDIS_HOST=valkey
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=

PROJECT_NAME=MetaGer
BRANCH_NAME=Local
COMMIT_NAME=Testing

BROWSERSTACK_BROWSER=WINDOWS_10_FIREFOX
BROWSERSTACK_SEPARATE_SESSIONS=true

SELENIUM_HOST=selenium_standalone_firefox
#FETCHER_PROXY_HOST=host.docker.internal
#FETCHER_PROXY_PORT=8081

# Reverb Websocket server
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_APP_ID=metager-testing
REVERB_APP_KEY=METAGER_TESTING
REVERB_APP_SECRET=METAGER_TESTING_SECRET
REVERB_ALLOWED_ORIGINS=metager.de

# GlitchTip error tracking (self-hosted, Sentry-protocol-compatible). Empty
# disables the SDK entirely -- see config/sentry.php and App\Support\SentryEventScrubber.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.01
