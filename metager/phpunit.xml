<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <!--
        tests/Browser is deliberately absent here. Those are Dusk tests: they drive a real
        browser and need a reachable Selenium, so sweeping them into `php artisan test` made
        the default run depend on infrastructure it has no business needing. They live in
        phpunit.dusk.xml and run via `php artisan dusk`.
    -->
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory suffix="Test.php">tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            The whole suite runs in one PHP process, and the fpm image ships the
            default memory_limit of 128M. That was never a deliberate budget for
            it, and the suite had quietly grown to within a few page renders of
            the ceiling: adding tests would fail with "Allowed memory size
            exhausted" somewhere unrelated to the test that tipped it over —
            usually inside endroid/qr-code rendering /spende, or inside PHPUnit's
            own metadata parser, neither of which is the culprit.

            Diagnosing that costs an hour every time, and the answer is always
            "raise the limit", so it is raised here once. Note this is a ceiling,
            not an allocation: a run that needs 200M still only uses 200M.
        -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <!-- Force-disabled rather than just unset: a developer's local .env can carry a
             real DSN, needed to smoke-test the integration against GlitchTip directly.
             Without this override that DSN leaks into the test run, and every
             exception-throwing test reports a live event. -->
        <env name="SENTRY_LARAVEL_DSN" value="" force="true"/>
    </php>
</phpunit>
