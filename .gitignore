metager/_ide_helper.php
metager/.phpstorm.meta.php
metager/config/sumasEn.json
metager/config/suggestions.json
metager/.env.assistant
.gitignore
# Helm subcharts are fetched from their registry, not vendored. Matched by
# extension rather than by name so swapping the dependency does not leave the
# replacement silently tracked.
chart/charts/*.tgz

# Sqlite databases left behind by the test suite (--parallel writes one per worker)
metager/database/databases/

# Editor swap and lock files (vim .*.swp, nano writes the same name as a lock)
.*.sw[a-p]
